rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/meals/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /sharedMeals/{ownerId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == ownerId;
    }
    match /sharedMeals/{ownerId}/{shareId}/{fileName} {
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/sharedMeals/$(shareId)).data.expiresAt > request.time;
    }
  }
}
