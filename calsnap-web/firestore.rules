rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/profile/{profileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/meals/{mealId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/weighIns/{weighInId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/favorites/{favoriteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /sharedMeals/{shareId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(3, 'd') + duration.value(1, 'h');
      allow get: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || request.time < resource.data.expiresAt);
      allow list, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
